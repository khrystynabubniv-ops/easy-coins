# Postgres connection string. Locally: postgresql://dev:dev@localhost:5432/easycoins?schema=public
# On Railway: reference the Postgres service variable ${{Postgres.DATABASE_URL}}
DATABASE_URL=
# Slack app → OAuth & Permissions → Bot User OAuth Token (xoxb-…)
SLACK_BOT_TOKEN=
# Slack app → Basic Information → App Credentials → Signing Secret
SLACK_SIGNING_SECRET=
# Bearer token for POST /api/admin/broadcast (min 32 chars, e.g. `openssl rand -hex 32`)
ADMIN_API_SECRET=
# Comma-separated Slack user IDs who receive the weekly question, e.g. U012ABCDEF,U034GHIJKL
ALLOWED_SLACK_IDS=
# Coins per recommendation and bonus when a recruiter takes it into work
COINS_BASE=5
COINS_BONUS=15
